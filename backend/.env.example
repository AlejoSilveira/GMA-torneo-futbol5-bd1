# Copiar a .env y completar. El .env NO se sube al repo.
# Dentro de Docker DB_HOST=db (nombre del servicio); corriendo local, localhost.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=torneo_futbol5

DB_ADMIN_USER=torneo_admin
DB_ADMIN_PASSWORD=
DB_PLANILLERO_USER=torneo_planillero
DB_PLANILLERO_PASSWORD=

# Clave para firmar los tokens de login (cualquier texto largo y aleatorio)
JWT_SECRET=
JWT_EXPIRA_HORAS=8

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
